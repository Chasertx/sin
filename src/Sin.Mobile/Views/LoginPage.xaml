<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sin.Mobile.ViewModels"
             x:Class="Sin.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="28,80,28,28" Spacing="14">
            <Label Text="🚩" FontSize="64" HorizontalOptions="Center" />
            <Label Text="Sin" Style="{StaticResource Title}" FontSize="44" HorizontalOptions="Center" />
            <Label Text="The anti-dating app. Lead with your worst."
                   Style="{StaticResource Muted}" FontSize="15" HorizontalTextAlignment="Center" Margin="0,0,0,24" />

            <!-- SSO: one button per provider the server has enabled -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding HasProviders}"
                                 BindableLayout.ItemsSource="{Binding Providers}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Text="{Binding ., StringFormat='Continue with {0}'}" Clicked="OnSsoClicked"
                                BackgroundColor="{StaticResource Ink}" TextColor="#140A0C" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="or use email" Style="{StaticResource Muted}" HorizontalOptions="Center"
                   IsVisible="{Binding HasProviders}" Margin="0,4" />

            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
            <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True"
                   ReturnCommand="{Binding LoginCommand}" />

            <Button Text="Log in" Command="{Binding LoginCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,8,0,0" />
            <Button Text="Create an account" Style="{StaticResource Ghost}" Command="{Binding GoToRegisterCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="Use a demo account" Style="{StaticResource Muted}" HorizontalOptions="Center"
                   TextDecorations="Underline" Margin="0,24,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding UseDemoAccountCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
