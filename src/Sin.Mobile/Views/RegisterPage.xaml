<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sin.Mobile.ViewModels"
             x:Class="Sin.Mobile.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Join Sin">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Be honest. Brutally." Style="{StaticResource Title}" FontSize="26" />
            <Label Text="Normal apps want your best angle. We want the rest." Style="{StaticResource Muted}" Margin="0,0,0,12" />

            <Label Text="Account" Style="{StaticResource Section}" />
            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
            <Entry Placeholder="Password (8+ characters)" Text="{Binding Password}" IsPassword="True" />

            <Label Text="About you" Style="{StaticResource Section}" Margin="0,12,0,0" />
            <Entry Placeholder="First name" Text="{Binding DisplayName}" />
            <Entry Placeholder="Age" Text="{Binding AgeText}" Keyboard="Numeric" />
            <Picker Title="I am a..." ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}" />
            <Picker Title="Interested in..." ItemsSource="{Binding Interests}" SelectedItem="{Binding InterestedIn}" />

            <Button Text="Create account" Command="{Binding RegisterCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,16,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
