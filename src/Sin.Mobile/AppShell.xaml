<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Sin.Mobile.Views"
       x:Class="Sin.Mobile.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <ShellContent Route="login"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False"
                  ContentTemplate="{DataTemplate views:LoginPage}" />

    <TabBar Route="main">
        <ShellContent Title="🚩 Confessions" Route="feed" ContentTemplate="{DataTemplate views:FeedPage}" />
        <ShellContent Title="💬 Matches" Route="matches" ContentTemplate="{DataTemplate views:MatchesPage}" />
        <ShellContent Title="😈 My Problems" Route="me" ContentTemplate="{DataTemplate views:MyProfilePage}" />
    </TabBar>

</Shell>
