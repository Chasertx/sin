# Copy to .env (never commit .env) and fill in what you have. Blank = that sign-in option is hidden.

# Long random string used to sign login tokens
JWT_KEY=

# ---- Supabase (leave blank to use the local SQLite file) ----
# Database: Supabase > your project > Connect > "Session pooler" > URI (put your DB password in it)
DATABASE_PROVIDER=Postgres
DATABASE_URL=
# Photos: Supabase > Project Settings > API > Project URL and the service_role secret
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (type: Web application)
#   Authorized redirect URI: http://localhost:5080/signin-google   (plus https://<your-domain>/signin-google later)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: developer.apple.com > Certificates, IDs & Profiles (needs the paid Apple Developer Program)
#   1. Services ID (e.g. com.sinapp.sin.signin) with Sign in with Apple enabled
#      Return URL: https://<your-domain>/signin-apple   (Apple requires https and a real domain)
#   2. Keys > new key with Sign in with Apple > download AuthKey_XXXX.p8 to ./secrets/apple_authkey.p8
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
