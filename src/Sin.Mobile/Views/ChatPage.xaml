<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sin.Mobile.ViewModels"
             x:Class="Sin.Mobile.Views.ChatPage"
             x:DataType="vm:ChatViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Unmatch" Command="{Binding UnmatchCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <CollectionView x:Name="MessagesList" ItemsSource="{Binding Messages}" ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.EmptyView>
                <Label Text="Ask about their worst flaw. It's literally the point."
                       Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" Padding="32,80" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageItem">
                    <VerticalStackLayout Padding="12,4" HorizontalOptions="{Binding Align}" MaximumWidthRequest="320">
                        <Border BackgroundColor="{Binding Bubble}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14,9">
                            <Label Text="{Binding Text}" TextColor="White" />
                        </Border>
                        <Label Text="{Binding Time}" Style="{StaticResource MutedLabel}" FontSize="10"
                               HorizontalOptions="{Binding Align}" Margin="6,2" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,8,12,12"
              BackgroundColor="{StaticResource Surface}">
            <Entry Placeholder="Say something honest..." Text="{Binding Draft}" ReturnCommand="{Binding SendCommand}" />
            <Button Grid.Column="1" Text="Send" Command="{Binding SendCommand}" />
        </Grid>
    </Grid>
</ContentPage>
